OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
CORS_ORIGINS=http://localhost:5173
CORPUS_VERSION=local-dev
PROMPT_VERSION=chat-v1
ENVIRONMENT=dev
EMBED_MODE=openai
MAX_REQUEST_BODY_BYTES=512000
RATE_LIMIT_PER_MINUTE=30
# Optional Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Voice reply (POST /v1/chat/speak). TTS_MODE=mock (default) needs nothing below.
TTS_MODE=mock
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
